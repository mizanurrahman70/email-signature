# Cloudinary credentials (https://console.cloudinary.com/settings/api-keys)
# The API secret is only read on the server and never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of the deployed app; social icons in emails load from here.
# Optional on Vercel/Netlify (the current origin is used when unset).
NEXT_PUBLIC_SITE_URL=
